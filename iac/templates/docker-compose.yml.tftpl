services:
  mc-server:
    image: itzg/minecraft-server:2026.10.0
    container_name: mc-server
    restart: unless-stopped
    stop_grace_period: 2m
    ports:
      - "25565:25565"
      - "19132:19132/udp"
    environment:
      EULA: "TRUE"
      TYPE: "${server_type}"
      VERSION: "${minecraft_version}"
      MEMORY: "${jvm_memory}"
      USE_AIKAR_FLAGS: "true"
      MOTD: ${replace(jsonencode(motd), "$", "$$")}
      MAX_PLAYERS: "${max_players}"
      DIFFICULTY: "${difficulty}"
      ENABLE_RCON: "true"
      RCON_PORT: "25575"
      RCON_PASSWORD: ${replace(jsonencode(rcon_password), "$", "$$")}
      STOP_SERVER_ANNOUNCE_DELAY: "15"
%{ if whitelist_enabled ~}
      ENABLE_WHITELIST: "true"
      ENFORCE_WHITELIST: "true"
%{ if length(whitelist) > 0 ~}
      WHITELIST: |
%{ for w in whitelist ~}
        ${w}
%{ endfor ~}
%{ endif ~}
%{ endif ~}
%{ if length(ops) > 0 ~}
      OPS: |
%{ for o in ops ~}
        ${o}
%{ endfor ~}
%{ endif ~}
%{ if length(modrinth_projects) > 0 ~}
      MODRINTH_ALLOWED_VERSION_TYPE: "beta"
      MODRINTH_PROJECTS: |
%{ for m in modrinth_projects ~}
        ${m}
%{ endfor ~}
%{ endif ~}
      PLUGINS: |
%{ for p in plugins ~}
        ${p}
%{ endfor ~}
    volumes:
      - /mnt/mc-data:/data
    healthcheck:
      test: ["CMD-SHELL", "mc-health"]
      interval: 20s
      timeout: 10s
      retries: 5
      start_period: 2m
%{ if backup_enabled ~}
  mc-backup:
    image: itzg/mc-backup:2026.10.0
    container_name: mc-backup
    restart: unless-stopped
    stop_grace_period: 30s
    mem_limit: 512m
    depends_on:
      mc-server:
        condition: service_healthy
    environment:
      RCON_HOST: "mc-server"
      RCON_PORT: "25575"
      RCON_PASSWORD: ${replace(jsonencode(rcon_password), "$", "$$")}
      INITIAL_DELAY: "${backup_initial_delay}"
      BACKUP_INTERVAL: "${backup_interval}"
      PRUNE_BACKUPS_COUNT: "${backup_retention_count}"
      TAR_COMPRESS_METHOD: "zstd"
      ZSTD_PARAMETERS: "-3 --long"
%{ if backup_s3_bucket != "" ~}
      BACKUP_METHOD: "rclone"
      RCLONE_REMOTE: "backup:${backup_s3_bucket}"
      RCLONE_DEST_DIR: "minecraft-backups"
      RCLONE_CONFIG_BACKUP_TYPE: "s3"
      RCLONE_CONFIG_BACKUP_PROVIDER: ${replace(jsonencode(backup_s3_provider), "$", "$$")}
      RCLONE_CONFIG_BACKUP_ENDPOINT: ${replace(jsonencode(backup_s3_endpoint), "$", "$$")}
      RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID: ${replace(jsonencode(backup_s3_access_key), "$", "$$")}
      RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY: ${replace(jsonencode(backup_s3_secret_key), "$", "$$")}
%{ else ~}
      BACKUP_METHOD: "tar"
%{ endif ~}
    volumes:
      - /mnt/mc-data:/data:ro
      - /mnt/mc-data/backups:/backups
%{ endif ~}
